# Web build of the sales app (tool/build_web.sh); built per machine, not committed
/backend/static/sales/

# The office server's HTTPS keys (backend/office_https.py). Private: never commit.
/backend/certs/

# Generated quotation PDFs
backend/generated_pdfs/

# Server secrets (API keys), e.g. backend/.env. Never commit.
.env

# Floor plan images stored with quotes (backend/main.py)
backend/plan_images/

# Pictures of designs stored with quotes (backend/main.py)
backend/design_pictures/

# Live catalogue and its version history (backend/catalog.py): per-installation data, seeded from assets/catalog/default_catalog.json
/backend/catalog_store/
